# Maintainer: inukaasith <inukaasith@users.noreply.github.com>
pkgname=twindesk-bin
_pkgname=twindesk
pkgver=2.5.0
pkgrel=1
pkgdesc="Share mouse, keyboard, clipboard, files, sound and screens with a Mac, a PC, another Linux computer or a phone"
arch=('x86_64')
url="https://github.com/Sajeevanveeriah/DuoDesk"
license=('GPL-3.0-only')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs'
         'libsecret' 'libxi' 'libxrandr' 'libxfixes' 'openssl' 'dbus' 'libpulse' 'polkit' 'glib2'
         'alsa-lib' 'mesa')
optdepends=('bluez: devices not on this network over Bluetooth'
            'networkmanager: Wi-Fi Direct to devices not on this network'
            'v4l2loopback-dkms: Camera › Virtual camera')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("DuoDesk-${pkgver}-amd64.deb::${url}/releases/download/v${pkgver}/DuoDesk-${pkgver}-amd64.deb")
# CI writes the actual release SHA-256; never publish this recipe without it.
sha256sums=('RELEASE_SHA256_REQUIRED')

package() {
  bsdtar -xf "$srcdir/data.tar."* -C "$pkgdir"
  # electron-builder's .deb installs to /opt/DuoDesk; its postinst (not run here) links /usr/bin/twindesk
  install -d "$pkgdir/usr/bin"
  ln -sf /opt/DuoDesk/twindesk "$pkgdir/usr/bin/twindesk"
  install -Dm644 "$pkgdir/opt/DuoDesk/resources/app/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
