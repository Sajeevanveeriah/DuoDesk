{
  "appId": "org.macshare.mac",
  "productName": "DuoDesk",
  "artifactName": "DuoDesk-${version}-${arch}.${ext}",
  "directories": { "output": "dist" },
  "publish": null,
  "mac": { "target": [{ "target": "dmg", "arch": ["arm64"] }], "category": "public.app-category.utilities", "identity": null },
  "dmg": {
